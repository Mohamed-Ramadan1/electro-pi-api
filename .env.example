NODE_ENV=development

ENABLE_SWAGGER=true

# Database configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=electro-pi-dev
DATABASE_USER=myuser
DATABASE_PASSWORD=change-me

# Redis configuration (Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=electro-pi:

# Logging configuration
LOG_LEVEL=debug
DEFAULT_LOG_DIR=./logs
DEFAULT_LOG_FILE=app.log
DEFAULT_LOG_MAX_SIZE=10m
DEFAULT_LOG_MAX_FILES=5

# JWT configuration
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=electro-pi-api
JWT_AUDIENCE=electro-pi

# Queue configuration (BullMQ)
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=1
QUEUE_PREFIX=noviq
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=5000
QUEUE_REMOVE_ON_COMPLETE=1000
QUEUE_REMOVE_ON_FAIL=5000

# AWS S3 configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-bucket-name
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
S3_SIGNED_URL_EXPIRES_SECONDS=900
S3_KEY_PREFIX=uploads

# Email configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@example.com
EMAIL_SECURE=false

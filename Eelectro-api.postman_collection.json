              "listen": "test",
              "script": {
                "exec": [
                  "const accessToken = pm.cookies.get('access-token');",
                  "const refreshToken = pm.cookies.get('refresh-token');",
                  "",
                  "if (accessToken) {",
                  "  pm.environment.set('accessToken', accessToken);",
                  "}",
                  "if (refreshToken) {",
                  "  pm.environment.set('refreshToken', refreshToken);",
                  "}"
